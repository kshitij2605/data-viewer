EMBEDDING_ENDPOINT=http://embedding-host:8000
EMBEDDING_API_KEY=__REDACTED_EMBEDDING_API_KEY__
EMBEDDING_MODEL=BAAI/bge-m3
DB_PATH=data/data_viewer.db
# Full SQLAlchemy URL (PostgreSQL recommended for production). Empty = SQLite at DB_PATH.
DATABASE_URL=
SECRET_KEY=__REDACTED_SECRET_KEY__
PORT=8080

# Production scaling / LLM throttling
WEB_CONCURRENCY=4
LLM_MAX_CONCURRENCY=6
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60
AI_SUGGESTION_IMAGE_MAX_PX=1024

# Elasticsearch (for rag_anything integration)
ES_URL=https://elasticsearch-host:9200
ES_USER=__REDACTED_ES_USER__
ES_PASSWORD=
ES_VERIFY_CERTS=false

# MinIO (for rag_anything asset serving)
MINIO_ENDPOINT=minio-host:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rag-anything
MINIO_SECURE=false

# LDAP / Active Directory (leave LDAP_URL empty to disable LDAP login)
LDAP_URL=ldap://ldap-host:389
LDAP_BIND_DN=bind-user@example.com
LDAP_BIND_CREDENTIALS=
LDAP_USER_SEARCH_BASE=DC=example,DC=com
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_STARTTLS=false
LDAP_TLS_REJECT_UNAUTHORIZED=false
LDAP_LOGIN_USES_USERNAME=true
